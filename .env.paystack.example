# Paystack Configuration
# Get your API keys from https://dashboard.paystack.com/#/settings/developer

# Paystack Secret Key (starts with sk_test_ for test mode, sk_live_ for production)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Paystack Public Key (starts with pk_test_ for test mode, pk_live_ for production)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# App URL for payment callbacks (update for production)
APP_URL=interviewready://

# Supabase Configuration (already in .env.example, included here for reference)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Expo Public Variables (for mobile app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
