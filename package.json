{
  "name": "interview-ready",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "serve:web": "node scripts/serve-web.js",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "build:android": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@supabase/supabase-js": "^2.49.0",
    "@tanstack/react-query": "^5.62.0",
    "docx": "^9.7.1",
    "expo": "~56.0.20",
    "expo-asset": "~56.0.17",
    "expo-auth-session": "~56.0.17",
    "expo-build-properties": "~56.0.26",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.12",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.19",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.25",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paystack-webview": "^4.6.7",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.2.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "tabler-icons-react-native": "^3.1.0",
    "tslib": "^2.8.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "babel-plugin-transform-imports": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "expo-doctor": "^1.20.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-doctor": "^0.7.6",
    "supabase": "^2.107.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^react-native-url-polyfill/auto$": "<rootDir>/__mocks__/react-native-url-polyfill.js"
    }
  }
}
