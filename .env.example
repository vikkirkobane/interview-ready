# ==========================================
# Interview Ready - Environment Configuration
# ==========================================

# 1. Spaceship (Spacemail) SMTP Email Configuration
# --------------------------------------------------
SPACESHIP_SMTP_HOST=mail.spacemail.com
SPACESHIP_SMTP_PORT=465
SPACESHIP_SMTP_SECURE=true
SPACESHIP_SMTP_USER=info@appinterviewready.top
SPACESHIP_SMTP_PASS=your_mailbox_password_here
SPACESHIP_FROM_EMAIL="Interview Ready <info@appinterviewready.top>"

# 2. Airtable API Configuration (Spreadsheet View)
# --------------------------------------------------
# Get your Personal Access Token from https://airtable.com/create/tokens (Scope: data.records:write)
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXX
# Your Base ID from the Airtable URL (e.g. https://airtable.com/appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Table name in your Airtable base (default: Submissions)
AIRTABLE_TABLE_NAME=Submissions

# 3. Application & Download URL
# --------------------------------------------------
APP_URL=https://appinterviewready.top

# 4. Google Gemini AI & Firebase (Optional)
# --------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
