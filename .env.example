# Copy to .env and fill in your Supabase project values.
# For EAS cloud builds, set these as project secrets instead:
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..." --type string
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..." --type string

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ScrapeGraphAI - Required for LinkedIn Profile Scraping edge function
SGAI_API_KEY=your-scrapegraphai-api-key

# OCR.Space API Key for extracting text from images and PDFs
OCR_SPACE_API_KEY=your_ocr_space_api_key_here