# ==========================================
# Interview Ready - Environment Configuration
# ==========================================

# 1. Spaceship (Spacemail) SMTP Email Configuration
# --------------------------------------------------
# Host: For Spaceship Spacemail, standard host is mail.spacemail.com
SPACESHIP_SMTP_HOST=mail.spacemail.com
# Port: 465 for SSL (recommended) or 587 for TLS
SPACESHIP_SMTP_PORT=465
# Secure: true if using port 465 (SSL), false for port 587
SPACESHIP_SMTP_SECURE=true
# Your mailbox address created on Spaceship (e.g. info@appinterviewready.top or contact@yourdomain.com)
SPACESHIP_SMTP_USER=info@appinterviewready.top
# Your Spaceship mailbox password
SPACESHIP_SMTP_PASS=your_mailbox_password_here
# Display sender name and email
SPACESHIP_FROM_EMAIL="Interview Ready <info@appinterviewready.top>"

# 2. Application & Download URL
# --------------------------------------------------
# The public URL where this app is hosted on Vercel (used in email download links)
# e.g., https://interview-ready.vercel.app or https://appinterviewready.top
APP_URL=https://appinterviewready.top

# Direct Mobile App Download Link (Optional: overrides default /downloads/interview-ready.apk)
# MOBILE_APK_URL=https://your-storage-bucket.com/interview-ready.apk

# 3. Google Gemini AI & Firebase (Existing Features)
# --------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
