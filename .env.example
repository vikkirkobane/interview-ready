# Copy to .env and fill in your Supabase project values.
# For EAS cloud builds, set these as project secrets instead:
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..." --type string
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..." --type string

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Paystack API Keys - Get from your Paystack Dashboard
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here
PAYSTACK_SECRET_KEY=sk_test_your-secret-key-here
PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here

# ScrapeGraphAI - Required for LinkedIn Profile Scraping edge function
SGAI_API_KEY=your-scrapegraphai-api-key

# OCR.Space API Key for extracting text from images and PDFs
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Qwen Cloud / DashScope API Key — primary AI provider (qwen-omni-turbo)
# Get your key at: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenRouter API Key — fallback AI provider (nvidia/nemotron-3-super-120b-a12b:free)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Sign-In Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 credentials for your app
# Android-first: Add your Android package name and SHA-1 fingerprint
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# LinkedIn OAuth Configuration
# Get these from LinkedIn Developer Portal: https://developer.linkedin.com/
# Create an OAuth 2.0 application
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=your-linkedin-client-id
EXPO_PUBLIC_LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Spaceship (Spacemail) SMTP Configuration
SPACESHIP_SMTP_HOST=mail.spacemail.com
SPACESHIP_SMTP_PORT=465
SPACESHIP_SMTP_SECURE=true
SPACESHIP_SMTP_USER=info@appinterviewready.top
SPACESHIP_SMTP_PASS=your-spacemail-password
SPACESHIP_FROM_EMAIL="Interview Ready <info@appinterviewready.top>"

# Application URL
APP_URL=https://appinterviewready.top

# Airtable API Configuration
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=app5axaWoe4MblFFS
AIRTABLE_TABLE_NAME=Submissions

# Google AdSense (Web Deployment)
EXPO_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-3023396295642660
EXPO_PUBLIC_ADSENSE_SLOT_BANNER=4290296424

# Google AdMob (Mobile Android / iOS)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX