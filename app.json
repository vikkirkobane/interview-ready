{
  "expo": {
    "name": "Interview Ready",
    "slug": "interview-ready",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_padded.png",
    "scheme": "interviewready",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interviewready.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.interviewready.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_padded.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9822168149949485~6162462516"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildFeatures": {
              "buildConfig": true
            }
          }
        }
      ],
      "./withAndroidAllowBackup.js",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1b842899-c2d3-4be8-b092-f6b51717a4ff"
      }
    },
    "owner": "victor48s-team"
  }
}
