{
  "expo": {
    "name": "Interview Ready",
    "slug": "interview-ready",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_padded.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "interviewready",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interviewready.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.interviewready.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon_padded.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c72af5f1-caef-40e0-b1f5-89808023140a"
      }
    },
    "owner": "kirkobane"
  }
}
